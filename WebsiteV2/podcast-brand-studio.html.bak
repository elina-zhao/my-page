<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Brand Studio · Podbean Concept</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=DM+Sans:wght@500;700&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════════════════════════════
   RESET & BASE
   ══════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f4f4f6;
  color: #111;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ══════════════════════════════════════════════════
   TOP BAR
   ══════════════════════════════════════════════════ */
.topbar {
  height: 56px;
  background: #fff;
  border-bottom: 1px solid #e5e5e5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  flex-shrink: 0;
  z-index: 100;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.topbar-logo {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 600;
  color: #111;
  letter-spacing: -.3px;
}

.topbar-logo-icon {
  width: 28px; height: 28px;
  background: #111;
  border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
}

.topbar-logo-icon svg { width: 14px; height: 14px; }

.topbar-badge {
  font-size: 10px;
  font-weight: 600;
  padding: 2px 10px;
  border-radius: 20px;
  background: #e8f5e9;
  color: #2e7d32;
  letter-spacing: .3px;
  display: flex;
  align-items: center;
  gap: 4px;
}

.topbar-badge::before {
  content: '';
  width: 5px; height: 5px;
  border-radius: 50%;
  background: #2e7d32;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.topbar-podcast-name {
  font-size: 13px;
  font-weight: 500;
  color: #555;
}

.topbar-sep {
  width: 1px;
  height: 20px;
  background: #e5e5e5;
}

/* ══════════════════════════════════════════════════
   MAIN LAYOUT
   ══════════════════════════════════════════════════ */
.main {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* ══════════════════════════════════════════════════
   LEFT PANEL
   ══════════════════════════════════════════════════ */
.panel {
  width: 340px;
  min-width: 340px;
  background: #fff;
  border-right: 1px solid #e5e5e5;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.panel-inner {
  padding: 24px 20px;
  flex: 1;
}

.panel-section {
  margin-bottom: 28px;
}

.panel-section:last-child { margin-bottom: 0; }

.panel-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #999;
  margin-bottom: 12px;
}

/* ── Background Toggle ── */
.bg-toggle {
  display: flex;
  gap: 6px;
}

.bg-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 12px;
  border-radius: 10px;
  cursor: pointer;
  transition: background .15s, border-color .15s, color .15s;
  border: 1.5px solid #e5e5e5;
  background: #fff;
  color: #888;
  font-size: 13px;
  font-weight: 500;
  font-family: inherit;
}

.bg-option:hover {
  background: #f8f8f8;
  color: #555;
}

.bg-option.active {
  background: #f0f0f0;
  border-color: #111;
  color: #111;
}

.bg-option svg {
  flex-shrink: 0;
}

/* ── AI Generation Button ── */

/* ── AI Generation Button ── */
.ai-generate {
  width: 100%;
  padding: 12px 16px;
  border: none;
  border-radius: 10px;
  background: #111;
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  transition: background .15s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 20px;
}

.ai-generate:hover { background: #333; }

.ai-generate svg { width: 16px; height: 16px; }

/* ── Section Toggles ── */
.section-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.section-toggle {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 8px 8px 2px;
  border-radius: 8px;
  cursor: grab;
  transition: background .15s, box-shadow .15s, opacity .15s;
  user-select: none;
  background: #fff;
}

.section-toggle:hover { background: #f8f8f8; }

.section-toggle.dragging {
  opacity: 0.4;
  background: #f0f0f0;
}

.section-toggle.drag-over {
  border-top: 2px solid #3b82f6;
  margin-top: -2px;
}

.section-toggle.drag-over-bottom {
  border-bottom: 2px solid #3b82f6;
  margin-bottom: -2px;
}

.section-toggle-drag {
  font-size: 13px;
  color: #ccc;
  letter-spacing: -1px;
  cursor: grab;
  flex-shrink: 0;
  width: 16px;
  text-align: center;
}

.section-toggle:hover .section-toggle-drag {
  color: #999;
}

.section-toggle-icon {
  width: 28px; height: 28px;
  border-radius: 6px;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  flex-shrink: 0;
}

.section-toggle-label {
  flex: 1;
  font-size: 13px;
  font-weight: 500;
  color: #333;
}

.section-toggle-badge {
  font-size: 10px;
  color: #999;
  background: #f0f0f0;
  padding: 1px 8px;
  border-radius: 10px;
}

.toggle-switch {
  position: relative;
  width: 36px;
  height: 20px;
  flex-shrink: 0;
}

.toggle-switch input { display: none; }

.toggle-slider {
  position: absolute;
  inset: 0;
  border-radius: 20px;
  background: #ccc;
  cursor: pointer;
  transition: background .2s;
}

.toggle-slider::before {
  content: '';
  position: absolute;
  width: 14px; height: 14px;
  left: 3px; top: 3px;
  border-radius: 50%;
  background: #fff;
  transition: transform .2s;
}

.toggle-switch input:checked + .toggle-slider { background: #111; }
.toggle-switch input:checked + .toggle-slider::before { transform: translateX(16px); }

/* ── Content Pipeline ── */
.pipeline-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 4px;
  font-size: 12.5px;
  color: #555;
}

.pipeline-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.pipeline-dot.active { background: #2e7d32; }
.pipeline-dot.pending { background: #f59e0b; }
.pipeline-dot.off { background: #ddd; }

.pipeline-text { flex: 1; }

.pipeline-time {
  font-size: 11px;
  color: #bbb;
}

.pipeline-item.highlight {
  background: #f8faf8;
  border-radius: 8px;
  padding: 8px 12px;
  margin-top: 4px;
}

/* ══════════════════════════════════════════════════
   PREVIEW AREA
   ══════════════════════════════════════════════════ */
.preview-area {
  flex: 1;
  background: #e8e8ec;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 28px 32px;
  overflow-y: auto;
  min-width: 0;
}

.preview-frame {
  width: 100%;
  max-width: 820px;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 20px rgba(0,0,0,.08), 0 0 0 1px rgba(0,0,0,.04);
}

.preview-frame-top {
  height: 36px;
  background: #f0f0f0;
  border-bottom: 1px solid #e0e0e0;
  display: flex;
  align-items: center;
  padding: 0 14px;
  gap: 7px;
}

.pf-dot { width: 10px; height: 10px; border-radius: 50%; }

.preview-content {
  /* Brand mode variables will be applied here */
  --p-bg: #ffffff;
  --p-card: #ffffff;
  --p-text: #111111;
  --p-text-secondary: #64748b;
  --p-accent: #111111;
  --p-accent-hover: #333333;
  --p-accent-soft: #f5f5f5;
  --p-nav-bg: #ffffff;
  --p-nav-text: #111111;
  --p-nav-border: #e5e5e5;
  --p-border: #e5e5e5;
  --p-radius: 8px;
  --p-radius-lg: 12px;
  --p-font-ui: "Inter", sans-serif;
  --p-font-heading: "Inter", sans-serif;
  --p-font-body: "Inter", sans-serif;
  --p-hero-layout: row;
  --p-hero-align: left;
  --p-card-shadow: 0 1px 3px rgba(0,0,0,.06);
  --p-card-radius: 8px;
  --p-nav-style: light;
}

/* ══════ BRAND MODE VARIATIONS ══════ */

/* Minimal */
.preview-content[data-mode="minimal"] {
  --p-bg: #ffffff;
  --p-card: #ffffff;
  --p-text: #1a1a1a;
  --p-text-secondary: #888888;
  --p-accent: #3b82f6;
  --p-accent-soft: #eff6ff;
  --p-nav-bg: #ffffff;
  --p-nav-text: #1a1a1a;
  --p-nav-border: #e5e5e5;
  --p-border: #eeeeee;
  --p-radius: 0px;
  --p-radius-lg: 0px;
  --p-font-heading: "Inter", sans-serif;
  --p-font-body: "Inter", sans-serif;
  --p-hero-layout: row;
  --p-hero-align: left;
  --p-card-shadow: none;
  --p-card-radius: 0px;
  --p-nav-style: light;
}

/* Dark Override */
.preview-content.dark {
  --p-bg: #121212;
  --p-card: #1e1e1e;
  --p-text: #e8e8e8;
  --p-text-secondary: #888888;
  --p-accent-soft: #1a2a3a;
  --p-nav-bg: #0d0d0d;
  --p-nav-text: #e8e8e8;
  --p-nav-border: #2a2a2a;
  --p-border: #2a2a2a;
  --p-card-shadow: 0 2px 12px rgba(0,0,0,.3);
  --p-radius: 0px;
  --p-radius-lg: 0px;
  --p-card-radius: 0px;
}

/* Dark mode — Listen On items */
.preview-content.dark .pc-listen-item {
  background: #1a1a1a;
  border-color: #333;
  color: #ccc;
}
.preview-content.dark .pc-listen-item:hover {
  border-color: var(--p-accent);
  background: #1a2a3a;
}

/* Dark mode — Host section */
.preview-content.dark .pc-host {
  background: #1a1a1a;
  border-color: #333;
}
.preview-content.dark .pc-host-avatar {
  background: #333;
  color: #888;
}

/* Dark mode — Newsletter */
.preview-content.dark .pc-newsletter {
  background: #1a1a1a;
  border-color: #333;
}
.preview-content.dark .pc-newsletter-form input {
  background: #0d0d0d;
  border-color: #333;
  color: #e8e8e8;
}
.preview-content.dark .pc-newsletter-form input:focus {
  border-color: var(--p-accent);
}
.preview-content.dark .pc-newsletter-form input::placeholder {
  color: #666;
}

/* Dark mode — Hero action buttons */
.preview-content.dark .pc-hero-action-btn {
  background: #1a1a1a;
  border-color: #333;
  color: #ccc;
}
.preview-content.dark .pc-hero-action-btn:hover {
  border-color: var(--p-accent);
  color: var(--p-accent);
  background: #1a2a3a;
}
.preview-content.dark .pc-hero-follow {
  border-color: var(--p-accent);
  color: var(--p-accent);
  background: #1a2a3a;
}
.preview-content.dark .pc-hero-follow:hover {
  background: var(--p-accent);
  color: #fff;
}

/* Dark mode — Hero off indicator */
.preview-content.dark .pc-hero-off-indicator {
  border-bottom-color: #2a2a2a;
}
.preview-content.dark .pc-hero-off-line {
  background: #2a2a2a;
}

/* Dark mode — Episode cards */
.preview-content.dark .pc-ep-card {
  border-color: #2a2a2a;
  background: #1a1a1a;
}
.preview-content.dark .pc-ep-card:hover {
  box-shadow: 0 4px 20px rgba(0,0,0,.3);
}
.preview-content.dark .pc-ep-cover {
  background: #0d0d0d;
}

/* Dark mode — Episode metadata */
.preview-content.dark .pc-ep-date-sep {
  background: #444;
}
.preview-content.dark .pc-ep-action-btn {
  color: #666;
}
.preview-content.dark .pc-ep-action-btn:hover {
  background: #2a2a2a;
  color: var(--p-accent);
}
.preview-content.dark .pc-section-link { color: #666; }
.preview-content.dark .pc-section-link:hover { color: var(--p-accent); }

/* Dark mode — Footer */
.preview-content.dark .pc-footer {
  border-top-color: #2a2a2a;
}

/* Dark mode — Episode card accent bar */
.preview-content.dark .pc-ep-card.playing::after {
  background: var(--p-accent);
}

/* Dark mode — Now playing card state */
.preview-content.dark .pc-ep-card.playing .pc-ep-play-btn {
  background: var(--p-accent);
  color: #fff;
}


/* ══════════════════════════════════════════════════
   PREVIEW CONTENT STYLES (use CSS vars)
   ══════════════════════════════════════════════════ */
.preview-content {
  background: var(--p-bg);
  color: var(--p-text);
  font-family: var(--p-font-body);
  transition: background .4s ease, color .4s ease;
}

/* Navigation */
.pc-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32px;
  padding: 16px 32px;
  background: var(--p-nav-bg);
  border-bottom: 1px solid var(--p-nav-border);
  transition: background .4s ease, border-color .4s ease;
}

.pc-nav a {
  text-decoration: none;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: var(--p-nav-text);
  opacity: .65;
  transition: opacity .2s;
  font-family: var(--p-font-ui);
}

.pc-nav a:hover { opacity: 1; }
.pc-nav a.active { opacity: 1; font-weight: 600; }

/* Hero */
.pc-hero {
  display: flex;
  flex-direction: var(--p-hero-layout);
  align-items: center;
  gap: 40px;
  padding: 48px 40px 40px;
  text-align: var(--p-hero-align);
  transition: all .4s ease;
}

.pc-hero-cover {
  width: 180px; height: 180px;
  border-radius: var(--p-card-radius);
  flex-shrink: 0;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0,0,0,.12);
}

.pc-hero-cover img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}

.pc-hero-content { flex: 1; }

.pc-hero-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: var(--p-accent);
  margin-bottom: 8px;
  font-family: var(--p-font-ui);
}

.pc-hero-title {
  font-size: 36px;
  font-weight: 800;
  letter-spacing: -.03em;
  line-height: 1.15;
  color: var(--p-text);
  margin-bottom: 10px;
  font-family: var(--p-font-heading);
}

.pc-hero-tagline {
  font-size: 15px;
  color: var(--p-text-secondary);
  line-height: 1.6;
  margin-bottom: 20px;
  font-family: var(--p-font-body);
}

.pc-hero-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 22px;
  border: none;
  border-radius: 30px;
  background: var(--p-accent);
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  font-family: var(--p-font-ui);
  cursor: pointer;
  transition: background .2s, transform .15s;
}

.pc-hero-btn:hover { filter: brightness(1.12); transform: translateY(-1px); }

/* Hero actions (Share / Follow) */
.pc-hero-actions {
  display: flex;
  gap: 10px;
  margin-top: 20px;
}

.pc-hero-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 18px;
  border-radius: 30px;
  border: 1.5px solid var(--p-border);
  background: var(--p-card);
  color: var(--p-text);
  font-size: 13px;
  font-weight: 500;
  font-family: var(--p-font-ui);
  cursor: pointer;
  transition: border-color .2s, background .2s, color .2s;
}

.pc-hero-action-btn:hover {
  border-color: var(--p-accent);
  color: var(--p-accent);
  background: var(--p-accent-soft);
}

.pc-hero-action-btn svg {
  width: 15px;
  height: 15px;
}

/* Follow button - default state with color */
.pc-hero-follow {
  border-color: var(--p-accent);
  color: var(--p-accent);
  background: var(--p-accent-soft);
}

.pc-hero-follow:hover {
  background: var(--p-accent);
  color: #fff;
}

/* Follow button - following state */
.pc-hero-follow.following {
  border-color: var(--p-accent);
  background: var(--p-accent);
  color: #fff;
}

.pc-hero-follow.following:hover {
  filter: brightness(1.1);
}

/* Sections common */
.pc-section {
  padding: 0 40px 40px;
}

/* ── Hero Toggle States ── */
.pc-hero-wrap {
  overflow: hidden;
  transition: max-height .5s ease, opacity .4s ease;
  max-height: 600px;
  opacity: 1;
  position: relative;
}

.pc-hero-wrap.hero-off {
  max-height: 0;
  opacity: 0;
}

.pc-hero-off-indicator {
  display: none;
  align-items: center;
  gap: 10px;
  padding: 18px 40px;
  border-bottom: 1px solid var(--p-border);
  font-size: 12px;
  color: var(--p-text-secondary);
  font-family: var(--p-font-ui);
  transition: opacity .4s ease;
}

.pc-hero-off-indicator.visible {
  display: flex;
}

.pc-hero-off-line {
  flex: 1;
  height: 1px;
  background: var(--p-border);
}

.pc-hero-off-badge {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: #bbb;
  white-space: nowrap;
}

.pc-ep-grid-wrap {
  overflow: hidden;
  transition: max-height .5s ease, opacity .4s ease;
  max-height: 800px;
  opacity: 1;
}

.pc-ep-grid-wrap.grid-off {
  max-height: 0;
  opacity: 0;
}

/* Host section transitions */
.pc-host-wrap {
  overflow: hidden;
  transition: max-height .5s ease, opacity .4s ease;
  max-height: 400px;
  opacity: 1;
}

.pc-host-wrap.host-off {
  max-height: 0;
  opacity: 0;
}

/* Newsletter transitions */
.pc-newsletter-wrap {
  overflow: hidden;
  transition: max-height .5s ease, opacity .4s ease;
  max-height: 400px;
  opacity: 1;
}

.pc-newsletter-wrap.newsletter-off {
  max-height: 0;
  opacity: 0;
}

/* Listen On Section */
.pc-listen-wrap {
  overflow: hidden;
  transition: max-height .5s ease, opacity .4s ease;
  max-height: 300px;
  opacity: 1;
}

.pc-listen-wrap.listen-off {
  max-height: 0;
  opacity: 0;
}

.pc-listen {
  padding: 0;
}

.pc-listen-title {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--p-text-secondary);
  margin-bottom: 14px;
  font-family: var(--p-font-ui);
}

.pc-listen-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.pc-listen-item {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px;
  border-radius: 30px;
  background: var(--p-card);
  border: 1px solid var(--p-border);
  text-decoration: none;
  font-size: 13px;
  font-weight: 500;
  color: var(--p-text);
  transition: border-color .2s, background .2s, box-shadow .2s;
  font-family: var(--p-font-body);
}

.pc-listen-item:hover {
  border-color: var(--p-accent);
  background: var(--p-accent-soft);
  box-shadow: 0 2px 8px rgba(0,0,0,.04);
}

.pc-listen-item img {
  width: 22px; height: 22px;
  border-radius: 4px;
  flex-shrink: 0;
}

.pc-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.pc-section-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--p-text);
  font-family: var(--p-font-heading);
  letter-spacing: -.02em;
}

.pc-section-link {
  font-size: 12px;
  font-weight: 500;
  color: var(--p-text-secondary);
  text-decoration: none;
  font-family: var(--p-font-ui);
}

.pc-section-link:hover { color: var(--p-accent); }

/* Episode Grid */
.pc-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.pc-ep-card {
  background: var(--p-card);
  border-radius: var(--p-card-radius);
  overflow: hidden;
  box-shadow: var(--p-card-shadow);
  border: 1px solid var(--p-border);
  transition: all .4s ease, box-shadow .3s ease, transform .3s ease;
  position: relative;
  cursor: pointer;
}

.pc-ep-card:hover {
  box-shadow: 0 4px 20px rgba(0,0,0,.08);
  transform: translateY(-2px);
}

.pc-ep-cover {
  aspect-ratio: 1;
  width: 100%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background: var(--p-bg);
}

.pc-ep-cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 4px;
  display: block;
  position: relative;
  z-index: 1;
  box-shadow: 0 2px 8px rgba(0,0,0,.12);
}

.pc-ep-cover-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.08);
  transition: background .3s ease;
  z-index: 2;
  border-radius: 4px;
}

.pc-ep-card:hover .pc-ep-cover-overlay {
  background: rgba(0,0,0,.03);
}

/* Episode number badge */
/* Play button */
.pc-ep-play-btn {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  width: 46px; height: 46px;
  border-radius: 50%;
  border: none;
  background: var(--p-accent);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: background .2s, transform .2s, box-shadow .2s;
  box-shadow: 0 2px 12px rgba(0,0,0,.18);
}

.pc-ep-card:hover .pc-ep-play-btn {
  filter: brightness(1.12);
  transform: translate(-50%, -50%) scale(1.06);
  box-shadow: 0 4px 20px rgba(0,0,0,.25);
}

.pc-ep-play-btn:active { transform: translate(-50%, -50%) scale(.92) !important; }

.pc-ep-play-btn svg {
  width: 18px; height: 18px;
  margin-left: 2px;
}

/* Now playing state */
.pc-ep-card.playing .pc-ep-play-btn {
  background: var(--p-accent);
  color: #fff;
  box-shadow: 0 2px 16px rgba(0,0,0,.25);
}

.pc-ep-card.playing .pc-ep-cover-overlay {
  background: rgba(0,0,0,.25);
}

.pc-ep-card.playing::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--p-accent);
  z-index: 3;
}

/* Card body */
.pc-ep-body {
  padding: 14px 16px 16px;
}

.pc-ep-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--p-text);
  margin-bottom: 4px;
  line-height: 1.35;
  font-family: var(--p-font-heading);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-clamp: 2;
  overflow: hidden;
}

.pc-ep-excerpt {
  font-size: 12px;
  color: var(--p-text-secondary);
  line-height: 1.5;
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-clamp: 2;
  overflow: hidden;
  font-family: var(--p-font-body);
}

.pc-ep-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Date */
.pc-ep-date {
  font-size: 11px;
  color: var(--p-text-secondary);
  font-family: var(--p-font-body);
  display: flex;
  align-items: center;
  gap: 6px;
}

.pc-ep-date-sep {
  width: 3px; height: 3px;
  border-radius: 50%;
  background: var(--p-border);
}

.pc-ep-date-dur {
  font-size: 11px;
  font-weight: 500;
  color: var(--p-text-secondary);
  font-family: var(--p-font-body);
}

.pc-ep-actions {
  display: flex;
  gap: 8px;
  opacity: 0;
  transition: opacity .2s ease;
}

.pc-ep-card:hover .pc-ep-actions {
  opacity: 1;
}

.pc-ep-action-btn {
  width: 28px; height: 28px;
  border: none;
  border-radius: 50%;
  background: transparent;
  color: var(--p-text-secondary);
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background .15s, color .15s;
  font-size: 12px;
}

.pc-ep-action-btn:hover { background: var(--p-accent-soft); color: var(--p-accent); }

/* Host Section */
.pc-host {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 32px;
  border-radius: var(--p-radius-lg);
  background: var(--p-card);
  border: 1px solid var(--p-border);
  transition: all .4s ease;
}

.pc-host-avatar {
  width: 72px; height: 72px;
  border-radius: 50%;
  flex-shrink: 0;
  background: linear-gradient(135deg, #ddd, #bbb);
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; color: #888;
}

.pc-host-info { flex: 1; }

.pc-host-name {
  font-size: 16px;
  font-weight: 700;
  color: var(--p-text);
  margin-bottom: 4px;
  font-family: var(--p-font-heading);
}

.pc-host-bio {
  font-size: 13px;
  color: var(--p-text-secondary);
  line-height: 1.6;
  font-family: var(--p-font-body);
}

/* Newsletter */
.pc-newsletter {
  text-align: center;
  padding: 40px;
  border-radius: var(--p-radius-lg);
  background: var(--p-card);
  border: 1px solid var(--p-border);
  transition: all .4s ease;
}

.pc-newsletter-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--p-text);
  margin-bottom: 8px;
  font-family: var(--p-font-heading);
}

.pc-newsletter-desc {
  font-size: 13px;
  color: var(--p-text-secondary);
  margin-bottom: 16px;
  font-family: var(--p-font-body);
}

.pc-newsletter-form {
  display: flex;
  gap: 8px;
  max-width: 380px;
  margin: 0 auto;
}

.pc-newsletter-form input {
  flex: 1;
  height: 42px;
  padding: 0 14px;
  border: 1px solid var(--p-border);
  border-radius: 20px;
  font-size: 13px;
  font-family: var(--p-font-ui);
  outline: none;
  color: var(--p-text);
  background: var(--p-bg);
}

.pc-newsletter-form input:focus { border-color: var(--p-accent); }

.pc-newsletter-form button {
  height: 42px;
  padding: 0 20px;
  border: none;
  border-radius: 20px;
  background: var(--p-accent);
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  font-family: var(--p-font-ui);
  cursor: pointer;
  transition: background .2s;
}

.pc-newsletter-form button:hover { filter: brightness(1.12); }

/* Footer */
.pc-footer {
  text-align: center;
  padding: 28px 40px;
  font-size: 12px;
  color: var(--p-text-secondary);
  border-top: 1px solid var(--p-border);
  font-family: var(--p-font-body);
  transition: all .4s ease;
}

/* ══════════════════════════════════════════════════
   COLOR PICKER
   ══════════════════════════════════════════════════ */
.color-picker-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}

.color-picker-preview {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2px solid #e5e5e5;
  flex-shrink: 0;
  transition: background .2s;
}

.color-picker-hex {
  font-size: 12px;
  font-weight: 500;
  color: #888;
  font-family: "SF Mono", "Menlo", monospace;
  flex: 1;
}

.color-reset-btn {
  width: 28px;
  height: 28px;
  border: 1px solid #e5e5e5;
  border-radius: 50%;
  background: #fff;
  color: #999;
  font-size: 14px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: border-color .15s, color .15s;
}

.color-reset-btn:hover { border-color: #999; color: #333; }

/* Color preset custom (+) button */
.color-preset-custom {
  background: #f5f5f5;
  border-color: #ddd;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.custom-plus {
  font-size: 18px;
  font-weight: 300;
  color: #888;
  line-height: 1;
}

.color-preset-custom:hover { border-color: #999; }
.color-preset-custom.active { border-color: #111; }

/* Custom color panel (expandable) */
.custom-color-panel {
  display: none;
  margin-top: 10px;
  padding: 14px;
  border-radius: 10px;
  background: #fff;
  border: 1px solid #e5e5e5;
  box-shadow: 0 2px 8px rgba(0,0,0,.04);
}

.custom-color-panel.open {
  display: block;
  animation: panelFadeIn .15s ease;
}

@keyframes panelFadeIn {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Hex label */
.custom-color-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: #bbb;
  margin-bottom: 8px;
}

.custom-color-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.custom-color-row input[type="color"] {
  width: 40px;
  height: 40px;
  border: 1.5px solid #ddd;
  border-radius: 8px;
  padding: 2px;
  cursor: pointer;
  background: transparent;
  flex-shrink: 0;
}

.custom-color-row input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
.custom-color-row input[type="color"]::-webkit-color-swatch { border: none; border-radius: 5px; }

.custom-color-row input[type="text"] {
  flex: 1 1 80px;
  min-width: 0;
  height: 40px;
  padding: 0 12px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  font-size: 13px;
  font-family: "SF Mono", "Menlo", monospace;
  color: #333;
  background: #f8f8f8;
  outline: none;
  transition: border-color .15s, background .15s;
}

.custom-color-row input[type="text"]:focus {
  border-color: #111;
  background: #fff;
}

.custom-color-row input[type="text"]::placeholder {
  color: #bbb;
  font-family: inherit;
  font-size: 12px;
}

.custom-color-apply {
  height: 40px;
  padding: 0 18px;
  border: none;
  border-radius: 8px;
  background: #111;
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  white-space: nowrap;
  transition: background .15s;
}

.custom-color-apply:hover {
  background: #333;
}

/* Font Selector (Dropdown) */
.font-select-wrapper {
  position: relative;
}

.font-select {
  width: 100%;
  height: 42px;
  padding: 0 36px 0 14px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  background: #fff;
  font-size: 13px;
  font-weight: 500;
  font-family: inherit;
  color: #333;
  outline: none;
  cursor: pointer;
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  transition: border-color .15s;
}

.font-select:focus { border-color: #111; }

.font-select-arrow {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 10px;
  color: #999;
  pointer-events: none;
}

.color-presets {
  display: flex;
  gap: 8px;
}

.color-preset {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid transparent;
  cursor: pointer;
  transition: border-color .15s, transform .15s;
  padding: 0;
}

.color-preset:hover { transform: scale(1.15); }
.color-preset.active { border-color: #111; }

/* ══════════════════════════════════════════════════
   SCROLLBAR
   ══════════════════════════════════════════════════ */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }

/* ══════════════════════════════════════════════════
   RESPONSIVE
   ══════════════════════════════════════════════════ */
@media (max-width: 1000px) {
  .panel { width: 280px; min-width: 280px; }
  .preview-area { padding: 16px; }
}

@media (max-width: 820px) {
  .main { flex-direction: column; }
  .panel { width: 100%; min-width: 0; max-height: 45vh; border-right: none; border-bottom: 1px solid #e5e5e5; }
  .preview-area { padding: 12px; }
  .preview-content { --p-hero-layout: column; --p-hero-align: center; }
  .pc-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .pc-hero { padding: 32px 24px 28px; }
  .pc-section { padding: 0 24px 28px; }
  .pc-hero-title { font-size: 28px; }
  .pc-hero-cover { width: 120px; height: 120px; }
  .pc-host { flex-direction: column; text-align: center; }
  .pc-hero-off-indicator { padding: 12px 24px; }
  .pc-hero-off-badge { font-size: 9px; }
  .pc-ep-actions { opacity: 1; }
  .pc-listen { padding: 0; }
  .pc-newsletter-form { flex-direction: column; }
  .pc-hero-off-indicator { padding: 10px 16px; }
  .pc-hero-actions { flex-direction: column; }
  .pc-hero-action-btn { justify-content: center; }
}

@media (max-width: 420px) {
  .pc-grid { grid-template-columns: 1fr; }
  .pc-ep-excerpt { display: none; }
}

/* Spinning animation for AI button */
@keyframes spin { to { transform: rotate(360deg); } }
.spinning { animation: spin .8s linear infinite; }

@media (max-width: 480px) {
  .panel-inner { padding: 16px; }
  .bg-option { font-size: 12px; padding: 8px 10px; }
  .pc-hero-title { font-size: 24px; }
  .pc-hero { padding: 24px 16px 20px; }
  .pc-section { padding: 0 16px 20px; }
  .pc-ep-title { font-size: 13px; }
  .pc-ep-body { padding: 12px 14px 14px; }
  .pc-listen { padding: 0; }
  .pc-listen-item { padding: 8px 14px; font-size: 12px; }
  .pc-listen-item img { width: 18px; height: 18px; }
}
</style>
</head>
<body>

<!-- ═══════════════ TOP BAR ═══════════════ -->
<header class="topbar">
  <div class="topbar-left">
    <div class="topbar-logo">
      <div class="topbar-logo-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
      </div>
      Brand Studio
    </div>
    <span class="topbar-badge">AI Auto-sync</span>
  </div>
  <div class="topbar-right">
    <span class="topbar-podcast-name">The Creative Pulse</span>
    <span class="topbar-sep"></span>
    <span style="font-size:12px;color:#999;">12 episodes</span>
  </div>
</header>

<!-- ═══════════════ MAIN LAYOUT ═══════════════ -->
<div class="main">

  <!-- ─── LEFT PANEL ─── -->
  <aside class="panel" id="leftPanel">
    <div class="panel-inner">

      <!-- AI Generate Button -->
      <button class="ai-generate" id="aiGenerateBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.364-6.364l-1.414 1.414M7.05 16.95l-1.414 1.414m12.728 0l-1.414-1.414M7.05 7.05L5.636 5.636"/><circle cx="12" cy="12" r="4"/></svg>
        AI Regenerate Site
      </button>

      <!-- Background Mode -->
      <div class="panel-section">
        <div class="panel-label">Background</div>
        <div class="bg-toggle" id="bgToggle">
          <button class="bg-option active" data-bg="light">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            Light
          </button>
          <button class="bg-option" data-bg="dark">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            Dark
          </button>
        </div>
      </div>

      <!-- Accent Color -->
      <div class="panel-section">
        <div class="panel-label">Theme Color</div>
        <div class="color-picker-row">
          <div class="color-picker-preview" id="colorPreview" style="background:#3b82f6;"></div>
          <span class="color-picker-hex" id="colorHexValue">#3b82f6</span>
          <button class="color-reset-btn" id="colorResetBtn" title="Reset to default">&#8634;</button>
        </div>
        <div class="color-presets" id="colorPresets">
          <button class="color-preset" data-color="#3b82f6" style="background:#3b82f6;" title="Blue"></button>
          <button class="color-preset" data-color="#06d6a0" style="background:#06d6a0;" title="Teal"></button>
          <button class="color-preset" data-color="#ff6b6b" style="background:#ff6b6b;" title="Coral"></button>
          <button class="color-preset" data-color="#8b5cf6" style="background:#8b5cf6;" title="Purple"></button>
          <button class="color-preset" data-color="#f59e0b" style="background:#f59e0b;" title="Gold"></button>
          <button class="color-preset color-preset-custom" id="customColorBtn" title="Custom color">
            <span class="custom-plus">+</span>
          </button>
        </div>
        <div class="custom-color-panel" id="customColorPanel">
          <div class="custom-color-label">Hex Value</div>
          <div class="custom-color-row">
            <input type="color" id="customColorPicker" value="#3b82f6">
            <input type="text" id="customHexInput" value="#3b82f6" placeholder="#000000" maxlength="7">
            <button class="custom-color-apply" id="customColorApply">Apply</button>
          </div>
        </div>
      </div>

      <!-- Font -->
      <div class="panel-section">
        <div class="panel-label">Font</div>
        <div class="font-select-wrapper">
          <select class="font-select" id="fontSelect">
            <option value="inter" selected>Inter</option>
            <option value="sans">System Sans</option>
            <option value="serif">Playfair Display</option>
            <option value="dm-sans">DM Sans</option>
          </select>
          <span class="font-select-arrow">&#9662;</span>
        </div>
      </div>

      <!-- Sections -->
      <div class="panel-section">
        <div class="panel-label">Sections <span style="font-weight:400;text-transform:none;letter-spacing:0;color:#bbb;font-size:10px;">&nbsp;· toggle on site</span></div>
        <div class="section-list" id="sectionToggles">
          <div class="section-toggle" draggable="true" data-section="listen">
            <span class="section-toggle-drag">⋮⋮</span>
            <span class="section-toggle-icon">&#9654;</span>
            <span class="section-toggle-label">Listen On</span>
            <label class="toggle-switch"><input type="checkbox" checked><span class="toggle-slider"></span></label>
          </div>
          <div class="section-toggle" draggable="true" data-section="grid">
            <span class="section-toggle-drag">⋮⋮</span>
            <span class="section-toggle-icon">&#9776;</span>
            <span class="section-toggle-label">Episode Grid</span>
            <label class="toggle-switch"><input type="checkbox" checked><span class="toggle-slider"></span></label>
          </div>
          <div class="section-toggle" draggable="true" data-section="host">
            <span class="section-toggle-drag">⋮⋮</span>
            <span class="section-toggle-icon">&#128100;</span>
            <span class="section-toggle-label">Host Introduction</span>
            <label class="toggle-switch"><input type="checkbox" checked><span class="toggle-slider"></span></label>
          </div>
          <div class="section-toggle" draggable="true" data-section="newsletter">
            <span class="section-toggle-drag">⋮⋮</span>
            <span class="section-toggle-icon">&#9993;</span>
            <span class="section-toggle-label">Newsletter CTA</span>
            <label class="toggle-switch"><input type="checkbox" checked><span class="toggle-slider"></span></label>
          </div>
          <div class="section-toggle" draggable="true" data-section="transcript">
            <span class="section-toggle-drag">⋮⋮</span>
            <span class="section-toggle-icon">&#128247;</span>
            <span class="section-toggle-label">Transcript Highlights</span>
            <label class="toggle-switch"><input type="checkbox"><span class="toggle-slider"></span></label>
          </div>
          <div class="section-toggle" draggable="true" data-section="reviews">
            <span class="section-toggle-drag">⋮⋮</span>
            <span class="section-toggle-icon">&#9733;</span>
            <span class="section-toggle-label">Listener Reviews</span>
            <label class="toggle-switch"><input type="checkbox"><span class="toggle-slider"></span></label>
          </div>
          <div class="section-toggle" draggable="true" data-section="support">
            <span class="section-toggle-drag">⋮⋮</span>
            <span class="section-toggle-icon">&#128176;</span>
            <span class="section-toggle-label">Support / Membership</span>
            <label class="toggle-switch"><input type="checkbox"><span class="toggle-slider"></span></label>
          </div>
        </div>
      </div>

      <!-- Content Pipeline -->
      <div class="panel-section">
        <div class="panel-label">Content Pipeline</div>
        <div class="pipeline-item">
          <span class="pipeline-dot active"></span>
          <span class="pipeline-text">RSS auto-sync</span>
          <span class="pipeline-time">active</span>
        </div>
        <div class="pipeline-item">
          <span class="pipeline-dot active"></span>
          <span class="pipeline-text">AI episode summaries</span>
          <span class="pipeline-time">auto</span>
        </div>
        <div class="pipeline-item">
          <span class="pipeline-dot active"></span>
          <span class="pipeline-text">SEO metadata</span>
          <span class="pipeline-time">auto</span>
        </div>
        <div class="pipeline-item">
          <span class="pipeline-dot pending"></span>
          <span class="pipeline-text">Transcript highlights</span>
          <span class="pipeline-time">processing</span>
        </div>
        <div class="pipeline-item">
          <span class="pipeline-dot off"></span>
          <span class="pipeline-text">Quote cards generation</span>
          <span class="pipeline-time">off</span>
        </div>
        <div class="pipeline-item highlight">
          <span style="flex:1;font-size:12px;color:#555;">Last synced 2 hours ago</span>
          <span style="font-size:11px;color:#999;">Sync now</span>
        </div>
      </div>

    </div>
  </aside>

  <!-- ─── PREVIEW AREA ─── -->
  <main class="preview-area">
    <div class="preview-frame">
      <div class="preview-frame-top">
        <div class="pf-dot" style="background:#ff5f57;"></div>
        <div class="pf-dot" style="background:#febc2e;"></div>
        <div class="pf-dot" style="background:#28c840;"></div>
        <span style="margin-left:12px;font-size:11px;color:#999;">thecreativepulse.podbean.com</span>
      </div>

      <!-- Preview Content -->
      <div class="preview-content" data-mode="minimal" id="previewContent" style="--p-accent:#3b82f6;">

        <!-- Nav -->
        <nav class="pc-nav">
          <a href="#" class="active">Home</a>
          <a href="#">Episodes</a>
          <a href="#">About</a>
          <a href="#">Subscribe</a>
        </nav>

        <!-- Hero Off Indicator (visible when hero is toggled off) -->
        <div class="pc-hero-off-indicator" id="heroOffIndicator">
          <span class="pc-hero-off-line"></span>
          <span class="pc-hero-off-badge">Hero hidden</span>
          <span class="pc-hero-off-line"></span>
        </div>

        <!-- Hero -->
        <div class="pc-hero-wrap" id="heroWrap" data-section="hero">
          <div class="pc-hero">
            <div class="pc-hero-cover"><img src="podcast-logo.png" alt="Podcast"></div>
            <div class="pc-hero-content">
              <h1 class="pc-hero-title">The Creative Pulse</h1>
              <p class="pc-hero-tagline">Conversations with the people shaping culture — from artists and musicians to writers and designers.</p>
              <div class="pc-hero-actions">
                <button class="pc-hero-action-btn pc-hero-share">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                  Share
                </button>
                <button class="pc-hero-action-btn pc-hero-follow">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                  Follow
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Listen On -->
        <div class="pc-section">
          <div class="pc-listen-wrap" id="listenWrap" data-section="listen">
            <div class="pc-listen">
              <div class="pc-listen-title">Listen On</div>
              <div class="pc-listen-grid">
                <a href="#" class="pc-listen-item"><img src="listen on logos/apple-podcast.png" alt="Apple Podcasts"> Apple Podcasts</a>
                <a href="#" class="pc-listen-item"><img src="listen on logos/spotify.png" alt="Spotify"> Spotify</a>
                <a href="#" class="pc-listen-item"><img src="listen on logos/AmazonMusic.png" alt="Amazon Music"> Amazon Music</a>
                <a href="#" class="pc-listen-item"><img src="listen on logos/BoomPlay.png" alt="BoomPlay"> BoomPlay</a>
                <a href="#" class="pc-listen-item"><img src="listen on logos/iHeartRadio.png" alt="iHeartRadio"> iHeartRadio</a>
                <a href="#" class="pc-listen-item"><img src="listen on logos/podbean-app.png" alt="Podbean App"> Podbean App</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Episode Grid -->
        <div class="pc-section">
          <div class="pc-ep-grid-wrap" id="gridWrap" data-section="grid">
            <div class="pc-section-header">
              <span class="pc-section-title">Latest Episodes</span>
              <a href="#" class="pc-section-link">View all &rarr;</a>
            </div>
            <div class="pc-grid">
              <div class="pc-ep-card" data-ep="0">
                <div class="pc-ep-cover">
                  <div class="pc-ep-cover-overlay"></div>
                  <img class="pc-ep-cover-img" src="podcast-logo.png" alt="">
                  <button class="pc-ep-play-btn"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="8 5 19 12 8 19"/></svg></button>
                </div>
                <div class="pc-ep-body">
                  <div class="pc-ep-title">Building Creative Communities Online</div>
                  <div class="pc-ep-excerpt">How digital platforms are reshaping the way artists connect, collaborate, and grow their audiences in 2026.</div>
                  <div class="pc-ep-footer">
                    <div class="pc-ep-date">May 29<span class="pc-ep-date-sep"></span><span class="pc-ep-date-dur">38 min</span></div>
                    <div class="pc-ep-actions">
                      <button class="pc-ep-action-btn" title="Share">&#8599;</button>
                      <button class="pc-ep-action-btn" title="Bookmark">&#9733;</button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="pc-ep-card" data-ep="1">
                <div class="pc-ep-cover">
                  <div class="pc-ep-cover-overlay"></div>
                  <img class="pc-ep-cover-img" src="podcast-logo.png" alt="">
                  <button class="pc-ep-play-btn"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="8 5 19 12 8 19"/></svg></button>
                </div>
                <div class="pc-ep-body">
                  <div class="pc-ep-title">The Future of Independent Media</div>
                  <div class="pc-ep-excerpt">An exploration of how indie creators are building sustainable media businesses outside traditional publishing models.</div>
                  <div class="pc-ep-footer">
                    <div class="pc-ep-date">May 22<span class="pc-ep-date-sep"></span><span class="pc-ep-date-dur">51 min</span></div>
                    <div class="pc-ep-actions">
                      <button class="pc-ep-action-btn" title="Share">&#8599;</button>
                      <button class="pc-ep-action-btn" title="Bookmark">&#9733;</button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="pc-ep-card" data-ep="2">
                <div class="pc-ep-cover">
                  <div class="pc-ep-cover-overlay"></div>
                  <img class="pc-ep-cover-img" src="podcast-logo.png" alt="">
                  <button class="pc-ep-play-btn"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="8 5 19 12 8 19"/></svg></button>
                </div>
                <div class="pc-ep-body">
                  <div class="pc-ep-title">Design Thinking in Everyday Life</div>
                  <div class="pc-ep-excerpt">A practical guide to applying design thinking principles to daily challenges — from cooking to career decisions.</div>
                  <div class="pc-ep-footer">
                    <div class="pc-ep-date">May 15<span class="pc-ep-date-sep"></span><span class="pc-ep-date-dur">41 min</span></div>
                    <div class="pc-ep-actions">
                      <button class="pc-ep-action-btn" title="Share">&#8599;</button>
                      <button class="pc-ep-action-btn" title="Bookmark">&#9733;</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Host Introduction -->
        <div class="pc-section">
          <div class="pc-host-wrap" id="hostWrap" data-section="host">
            <div class="pc-host">
              <div class="pc-host-avatar">&#128100;</div>
              <div class="pc-host-info">
                <div class="pc-host-name">Maya Rodriguez</div>
                <div class="pc-host-bio">Journalist, producer, and host of The Creative Pulse. With over a decade in podcasting, she's passionate about amplifying voices that challenge the status quo. Based in Brooklyn, NY.</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Newsletter -->
        <div class="pc-section">
          <div class="pc-newsletter-wrap" id="newsletterWrap" data-section="newsletter">
            <div class="pc-newsletter">
              <div class="pc-newsletter-title">Stay Inspired</div>
              <p class="pc-newsletter-desc">Get weekly insights from the world of creativity, delivered every Tuesday.</p>
              <div class="pc-newsletter-form">
                <input type="email" placeholder="your@email.com">
                <button type="submit">Subscribe</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Footer -->
        <div class="pc-footer">
          &copy; 2026 The Creative Pulse. Hosted by Podbean.
        </div>

      </div>
    </div>
  </main>

</div>

<script>
  // ════════════════════════════════════════════
  // ACCENT COLOR (PLAY BUTTON COLOR)
  // ════════════════════════════════════════════
  const previewContent = document.getElementById('previewContent');
  const colorPreview = document.getElementById('colorPreview');
  const colorHex = document.getElementById('colorHexValue');
  const colorPresets = document.querySelectorAll('.color-preset:not(.color-preset-custom)');
  const colorReset = document.getElementById('colorResetBtn');
  const defaultColor = '#3b82f6';
  const customColorBtn = document.getElementById('customColorBtn');
  const customColorPanel = document.getElementById('customColorPanel');
  const customColorPicker = document.getElementById('customColorPicker');
  const customHexInput = document.getElementById('customHexInput');
  const customColorApply = document.getElementById('customColorApply');

  function setAccentColor(hex) {
    previewContent.style.setProperty('--p-accent', hex);
    colorPreview.style.background = hex;
    colorHex.textContent = hex;
    colorPresets.forEach(p => p.classList.toggle('active', p.dataset.color === hex));
    customColorBtn.classList.toggle('active', false);
  }

  colorPresets.forEach(btn => {
    btn.addEventListener('click', () => setAccentColor(btn.dataset.color));
  });

  colorReset.addEventListener('click', () => setAccentColor(defaultColor));

  // Custom color panel toggle
  customColorBtn.addEventListener('click', () => {
    customColorPanel.classList.toggle('open');
  });

  // Sync color picker ↔ hex input
  customColorPicker.addEventListener('input', () => {
    customHexInput.value = customColorPicker.value;
  });

  customHexInput.addEventListener('input', () => {
    const val = customHexInput.value.trim();
    if (/^#[0-9a-fA-F]{6}$/.test(val)) {
      customColorPicker.value = val;
    }
  });

  // Apply custom color
  function applyCustomColor() {
    const val = customHexInput.value.trim();
    if (/^#[0-9a-fA-F]{6}$/.test(val)) {
      setAccentColor(val);
      customColorPanel.classList.remove('open');
    }
  }

  customColorApply.addEventListener('click', applyCustomColor);
  customHexInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') applyCustomColor();
  });

  // ════════════════════════════════════════════
  // BACKGROUND (LIGHT / DARK)
  // ════════════════════════════════════════════
  const bgOptions = document.querySelectorAll('.bg-option');

  bgOptions.forEach(opt => {
    opt.addEventListener('click', () => {
      bgOptions.forEach(o => o.classList.remove('active'));
      opt.classList.add('active');
      if (opt.dataset.bg === 'dark') {
        previewContent.classList.add('dark');
      } else {
        previewContent.classList.remove('dark');
      }
    });
  });

  // ════════════════════════════════════════════
  // FONT SWITCHING
  // ════════════════════════════════════════════
  const fontMap = {
    'inter': { heading: '"Inter", sans-serif', body: '"Inter", sans-serif', ui: '"Inter", sans-serif' },
    'sans': { heading: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif', body: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif', ui: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif' },
    'serif': { heading: '"Playfair Display", Georgia, serif', body: '"Inter", sans-serif', ui: '"Inter", sans-serif' },
    'dm-sans': { heading: '"DM Sans", sans-serif', body: '"Inter", sans-serif', ui: '"Inter", sans-serif' },
  };

  const fontSelect = document.getElementById('fontSelect');

  fontSelect.addEventListener('change', () => {
    const font = fontMap[fontSelect.value];
    if (font) {
      previewContent.style.setProperty('--p-font-heading', font.heading);
      previewContent.style.setProperty('--p-font-body', font.body);
      previewContent.style.setProperty('--p-font-ui', font.ui);
    }
  });

  // ════════════════════════════════════════════
  // SECTION TOGGLES & DRAG-AND-DROP
  // ════════════════════════════════════════════
  const sectionMap = {
    'listen': { el: () => document.getElementById('listenWrap'), offClass: 'listen-off' },
    'grid': { el: () => document.getElementById('gridWrap'), offClass: 'grid-off' },
    'host': { el: () => document.getElementById('hostWrap'), offClass: 'host-off' },
    'newsletter': { el: () => document.getElementById('newsletterWrap'), offClass: 'newsletter-off' },
  };

  // Toggle on checkbox change
  document.querySelectorAll('.section-toggle input[type="checkbox"]').forEach(cb => {
    cb.addEventListener('change', () => {
      const section = cb.closest('.section-toggle').dataset.section;
      const map = sectionMap[section];
      if (map && map.el()) {
        map.el().classList.toggle(map.offClass, !cb.checked);
      }
    });
  });

  // Drag-and-drop
  const sectionList = document.getElementById('sectionToggles');
  let dragSrc = null;

  sectionList.addEventListener('dragstart', (e) => {
    const toggle = e.target.closest('.section-toggle');
    if (!toggle) return;
    dragSrc = toggle;
    toggle.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', toggle.dataset.section);
  });

  sectionList.addEventListener('dragend', (e) => {
    const toggle = e.target.closest('.section-toggle');
    if (toggle) toggle.classList.remove('dragging');
    document.querySelectorAll('.section-toggle').forEach(t => {
      t.classList.remove('drag-over', 'drag-over-bottom');
    });
  });

  sectionList.addEventListener('dragover', (e) => {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    const target = e.target.closest('.section-toggle');
    if (!target || target === dragSrc) return;

    // Determine if dropping above or below target
    const rect = target.getBoundingClientRect();
    const midY = rect.top + rect.height / 2;
    const above = e.clientY < midY;

    document.querySelectorAll('.section-toggle').forEach(t => {
      t.classList.remove('drag-over', 'drag-over-bottom');
    });
    target.classList.toggle('drag-over', above);
    target.classList.toggle('drag-over-bottom', !above);
  });

  sectionList.addEventListener('drop', (e) => {
    e.preventDefault();
    const target = e.target.closest('.section-toggle');
    if (!target || !dragSrc || target === dragSrc) return;

    // Determine position
    const rect = target.getBoundingClientRect();
    const midY = rect.top + rect.height / 2;
    const insertBefore = e.clientY < midY;

    // Reorder panel
    if (insertBefore) {
      sectionList.insertBefore(dragSrc, target);
    } else {
      sectionList.insertBefore(dragSrc, target.nextSibling);
    }

    // Reorder preview content
    const srcSection = dragSrc.dataset.section;
    const targetSection = target.dataset.section;
    const previewContent = document.getElementById('previewContent');
    const srcMap = sectionMap[srcSection];
    const targetMap = sectionMap[targetSection];

    if (srcMap && srcMap.el() && targetMap && targetMap.el()) {
      const srcParent = srcMap.el().closest('.pc-section');
      const targetParent = targetMap.el().closest('.pc-section');
      if (srcParent && targetParent && srcParent !== targetParent) {
        if (insertBefore) {
          previewContent.insertBefore(srcParent, targetParent);
        } else {
          previewContent.insertBefore(srcParent, targetParent.nextSibling);
        }
      }
    }

    // Clean up
    document.querySelectorAll('.section-toggle').forEach(t => {
      t.classList.remove('drag-over', 'drag-over-bottom', 'dragging');
    });
    dragSrc = null;
  });

  // ════════════════════════════════════════════
  // AI REGENERATE (simulated)
  // ════════════════════════════════════════════
  const aiBtn = document.getElementById('aiGenerateBtn');
  if (aiBtn) {
    aiBtn.addEventListener('click', () => {
      const originalText = aiBtn.innerHTML;
      aiBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spinning"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> Generating...';
      aiBtn.disabled = true;
      aiBtn.style.opacity = '0.7';

      setTimeout(() => {
        // Randomly toggle some sections
        document.querySelectorAll('.section-toggle input[type="checkbox"]').forEach(cb => {
          const section = cb.closest('.section-toggle').dataset.section;
          const map = sectionMap[section];
          if (!map || !map.el()) return;
          const shouldShow = Math.random() > 0.3;
          cb.checked = shouldShow;
          map.el().classList.toggle(map.offClass, !shouldShow);
        });

        aiBtn.innerHTML = originalText;
        aiBtn.disabled = false;
        aiBtn.style.opacity = '1';
      }, 1200);
    });
  }

  // ════════════════════════════════════════════
  // EPISODE PLAY
  // ════════════════════════════════════════════
  const playIcon = '<svg viewBox="0 0 24 24" fill="currentColor"><polygon points="8 5 19 12 8 19"/></svg>';
  const pauseIcon = '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>';

  const epCards = document.querySelectorAll('.pc-ep-card');

  function setAllPaused() {
    epCards.forEach(c => {
      c.classList.remove('playing');
      const btn = c.querySelector('.pc-ep-play-btn');
      if (btn) btn.innerHTML = playIcon;
    });
  }

  epCards.forEach(card => {
    const playBtn = card.querySelector('.pc-ep-play-btn');
    if (playBtn) {
      playBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (card.classList.contains('playing')) {
          card.classList.remove('playing');
          playBtn.innerHTML = playIcon;
        } else {
          setAllPaused();
          card.classList.add('playing');
          playBtn.innerHTML = pauseIcon;
        }
      });
    }

    card.addEventListener('click', (e) => {
      if (e.target.closest('.pc-ep-action-btn')) return;
      const btn = card.querySelector('.pc-ep-play-btn');
      if (card.classList.contains('playing')) {
        card.classList.remove('playing');
        if (btn) btn.innerHTML = playIcon;
      } else {
        setAllPaused();
        card.classList.add('playing');
        if (btn) btn.innerHTML = pauseIcon;
      }
    });
  });

  // SHARE & FOLLOW
  const shareBtn = document.querySelector('.pc-hero-share');
  const followBtn = document.querySelector('.pc-hero-follow');

  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      const url = window.location.href;
      const title = 'The Creative Pulse — A podcast about creativity and culture';
      if (navigator.share) {
        navigator.share({ title, url }).catch(() => {});
      } else {
        navigator.clipboard.writeText(url).then(() => {
          shareBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Copied!';
          setTimeout(() => {
            shareBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg> Share';
          }, 2000);
        }).catch(() => {});
      }
    });
  }

  if (followBtn) {
    followBtn.addEventListener('click', () => {
      followBtn.classList.toggle('following');
      if (followBtn.classList.contains('following')) {
        followBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Following';
      } else {
        followBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg> Follow';
      }
    });
  }
</script>

</body>
</html>
